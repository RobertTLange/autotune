{
  "name": "@roberttlange/autotune",
  "version": "0.3.0",
  "description": "Automatic hyperparameter optimization CLI powered by headless and Optuna.",
  "keywords": [
    "hyperparameter-optimization",
    "optuna",
    "cli",
    "ai-agents",
    "machine-learning"
  ],
  "author": "Robert Lange <robertlange0@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertTLange/autotune.git"
  },
  "homepage": "https://github.com/RobertTLange/autotune#readme",
  "bugs": {
    "url": "https://github.com/RobertTLange/autotune/issues"
  },
  "type": "module",
  "bin": {
    "autotune": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/logo.png",
    "docs/*.svg",
    "examples/*/*.py",
    "examples/*/*.cpp",
    "examples/*/*.yaml",
    "examples/*/*.sh",
    "examples/*/*.sbatch",
    "examples/README.md",
    "CHANGELOG.md",
    "templates/*.py",
    "resources/headless-runtime/*.json",
    "resources/python-runtime.lock",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/chmod-bin.mjs",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.16.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
